# KrishiMitra AI - Environment Variables
# =======================================
# Copy this file to .env and update the values for your environment
# This file should be added to .gitignore

# Frontend Configuration
# ---------------------
# Vite uses VITE_ prefix for environment variables
# These are exposed to the client-side code

# Backend API URL for frontend
# In development: http://localhost:8000/api
# In production: Your deployed backend URL
# NOTE: For production, deploy backend separately and update this URL
FRONTEND_VITE_API_URL=https://your-backend-domain.com/api

# Backend Configuration
# ---------------------
# FastAPI environment variables
# These are used by the backend server

# Application settings
BACKEND_APP_NAME=KrishiMitra AI
BACKEND_ENVIRONMENT=development
BACKEND_VERSION=1.0.0
BACKEND_DEBUG=true

# CORS settings (comma-separated list of allowed origins)
# In development: http://localhost:5173,http://localhost:3000
# In production: Your frontend Vercel URL (e.g., https://your-frontend.vercel.app)
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Feature flags
BACKEND_ENABLE_DISEASE_DETECTION=true
BACKEND_ENABLE_WEATHER=true
BACKEND_ENABLE_MARKET=true
BACKEND_ENABLE_CHAT=true

# Authentication
# Generate a secure secret key: python -c "import secrets; print(secrets.token_urlsafe(32))"
BACKEND_SECRET_KEY=your-secure-secret-key-here-change-in-production
BACKEND_ALGORITHM=HS256
BACKEND_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Database (if applicable)
# BACKEND_DATABASE_URL=

# External API Keys (if applicable)
# BACKEND_WEATHER_API_KEY=
# BACKEND_MARKET_API_KEY=
# BACKEND_GEMINI_API_KEY=

# Note: For production, deploy the backend on a service that supports:
# - Python 3.11+
# - Larger deployment sizes (TensorFlow requires ~300MB+)
# - Persistent storage for ML model files
# Recommended: Render, Railway, Fly.io, or a VPS
