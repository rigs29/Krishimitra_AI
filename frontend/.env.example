# Frontend Environment Variables
# Copy this file to .env and .env.local for development
# Add to .gitignore to prevent committing secrets

# Backend API URL
# In development: http://localhost:8000/api
# In production: Your deployed backend URL (e.g., https://your-backend.vercel.app/api)
VITE_API_URL=https://your-backend-domain.vercel.app/api
