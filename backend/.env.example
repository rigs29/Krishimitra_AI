# KrishiMitra AI Backend - Environment Variables
# ==============================================
# Copy this file to .env and update the values for your environment
# This file should be added to .gitignore

# Application Settings
APP_NAME=KrishiMitra AI
ENVIRONMENT=production
VERSION=1.0.0
DEBUG=false

# CORS Configuration
# Comma-separated list of allowed origins
# For production: set to your frontend Vercel URL
# Example: CORS_ORIGINS=https://your-frontend.vercel.app
CORS_ORIGINS=*

# Server Settings
HOST=0.0.0.0
PORT=8000

# External API Keys (Required for full functionality)
# Get from: https://platform.openai.com/api-keys (or use Google Gemini)
GEMINI_API_KEY=your-gemini-api-key-here

# Get from: https://home.openweathermap.org/api_keys
OPENWEATHER_API_KEY=your-openweathermap-api-key-here

# Authentication Settings
# Generate a secure secret key: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-secure-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Feature Flags
ENABLE_DISEASE_DETECTION=true
ENABLE_WEATHER=true
ENABLE_MARKET=true
ENABLE_CHAT=true

# Database (if applicable in future)
# DATABASE_URL=

# Model Configuration
# Path to trained model files (relative to backend directory)
# MODEL_PATH=app/ml/models/plant_disease_model/model.h5
# LABELS_PATH=app/ml/models/plant_disease_model/labels.json

# File Upload Settings
MAX_FILE_SIZE_MB=5
UPLOAD_DIR=uploads
